# MySQL: alohida baza useri bilan (root SHART EMAS!).
# Shared hosting'da (masalan XUSS) bazani panel orqali yarating va
# paneldan olingan qiymatlarni bu yerga yozing.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=usr_duahfl_shop
DB_USER=usr_duahfl_shop
DB_PASSWORD=PANELDAN_OLINGAN_PAROL
# Ixtiyoriy: bitta URL ko'rinishida. Agar DATABASE_URL to'ldirilgan bo'lsa,
# u yuqoridagi DB_* qiymatlardan ustun turadi. Odatda bo'sh qoldiring:
# DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME?charset=utf8mb4
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
WEBAPP_URL=https://your-domain.example/
ADMIN_TELEGRAM_IDS=123456789
# Generate independently: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
HOST=0.0.0.0
PORT=8000
# Only for isolated local preview. NEVER enable on production:
APP_DEMO=0
